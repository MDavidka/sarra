[Unit]
Description=Syte Next.js Operator Frontend
After=network-online.target syte.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__SYTE_DIR__/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SYTE_API_ORIGIN=http://127.0.0.1:8787
ExecStart=/usr/bin/node __SYTE_DIR__/frontend/.next/standalone/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
